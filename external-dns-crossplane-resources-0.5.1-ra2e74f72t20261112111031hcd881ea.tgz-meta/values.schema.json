{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "accountID": {
            "type": "string"
        },
        "aws": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "accountID": {
                    "type": "string"
                },
                "awsPartition": {
                    "type": "string"
                },
                "managedDomain": {
                    "type": "string"
                },
                "oidcDomain": {
                    "type": "string"
                },
                "oidcDomains": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "awsCluster": {
            "type": "object",
            "additionalProperties": true
        },
        "awsPartition": {
            "type": "string"
        },
        "awsRegion": {
            "type": "string"
        },
        "azure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "location": {
                    "type": "string"
                },
                "mountPath": {
                    "type": "string"
                },
                "resourceGroupName": {
                    "type": "string"
                },
                "subscriptionID": {
                    "type": "string"
                }
            }
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "clusterName": {
            "type": "string"
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "managementCluster": {
            "type": "string"
        },
        "oidcDomain": {
            "type": "string"
        },
        "oidcDomains": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "provider": {
            "type": "string",
            "enum": [
                "aws",
                "aks",
                "azure"
            ]
        },
        "region": {
            "type": "string"
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        }
    }
}
